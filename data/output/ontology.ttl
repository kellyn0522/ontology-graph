@prefix onto: <http://example.org/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto:ApprovalDocument rdfs:subClassOf onto:Document .

onto:OperationalReport rdfs:subClassOf onto:Document .

onto:System onto:requires onto:Database .

onto:TechnicalDocument rdfs:subClassOf onto:Department,
        onto:Project .

onto:Department onto:manages onto:Document,
        onto:Employee,
        onto:Project,
        onto:Service .

onto:Service onto:requires onto:AuthenticationSystem .

onto:Project onto:includes onto:Database,
        onto:Document,
        onto:Employee .

